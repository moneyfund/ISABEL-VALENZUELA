rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'norvingarcia220@gmail.com'
          || request.auth.token.email == 'valenzuela.ing120@gmail.com'
        );
    }

    // Public website content and administrative demo visibility preferences.
    match /site/{pageId} {
      allow get: if pageId == 'public';
      allow list: if false;
      allow create, update, delete: if pageId == 'public' && isAdmin();
    }

    // Public reads of published listings only; authenticated admin may manage.
    match /properties/{propertyId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Public can create consented requests with a strictly validated schema.
    // Names, phone numbers, incomes and budgets are NEVER public-readable.
    function validGuideRequest() {
      let data = request.resource.data;
      let fields = [
        'firstName', 'lastName', 'phone', 'payment', 'property', 'income',
        'residence', 'documents', 'identified', 'price', 'savings',
        'consent', 'status', 'createdAt'
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.firstName is string
        && data.firstName.size() >= 2
        && data.firstName.size() <= 60
        && data.lastName is string
        && data.lastName.size() >= 2
        && data.lastName.size() <= 60
        && data.phone is string
        && data.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && data.payment in ['credito', 'contado']
        && data.property in ['casa', 'apartamento', 'terreno', 'finca', 'local']
        && data.income in ['asalariado', 'independiente', 'mixto', 'extranjero', 'no-comprobable']
        && data.residence in ['nicaragua', 'nic-exterior', 'extranjero']
        && data.documents in ['confirmado', 'pendiente', 'desconocido']
        && data.identified is bool
        && (
          data.price == null ||
          (data.price is number && data.price >= 0 && data.price <= 100000000)
        )
        && (
          data.savings == null ||
          (data.savings is number && data.savings >= 0 && data.savings <= 100000000)
        )
        && data.consent == true
        && data.status == 'nuevo'
        && data.createdAt == request.time;
    }


    function validGuideNameAndContact(data) {
      return data.firstName is string
        && data.firstName.size() >= 2 && data.firstName.size() <= 60
        && data.lastName is string
        && data.lastName.size() >= 2 && data.lastName.size() <= 60
        && data.phone is string
        && data.phone.matches('^\\+[1-9][0-9]{7,14}
      allow create: if requestId.matches('^[A-Za-z0-9]{20}$')
        && (validGuideRequest() || validServiceGuideRequest());
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['nuevo', 'contactado', 'atendido'];
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
);
    }

    function validPositiveOptional(value) {
      return value == null ||
        (value is number && value > 0 && value <= 100000000);
    }

    function validGuideLocation(value) {
      return value is string && value.size() >= 2 && value.size() <= 120;
    }

    function validSaleAnswers(a) {
      return a.keys().hasAll([
        'propertyType','location','documentStatus','mortgage',
        'occupancy','timing','askingPrice'
      ]) && a.keys().hasOnly([
        'propertyType','location','documentStatus','mortgage',
        'occupancy','timing','askingPrice'
      ])
      && a.propertyType in ['casa','apartamento','terreno','finca','local']
      && validGuideLocation(a.location)
      && a.documentStatus in ['inscrita','tramite','no-se']
      && a.mortgage in ['libre','hipoteca','no-se']
      && a.occupancy in ['desocupada','habitada','alquilada']
      && a.timing in ['ahora','1-3','explorando']
      && validPositiveOptional(a.askingPrice);
    }

    function validSeekAnswers(a) {
      return a.keys().hasAll([
        'businessType','location','size','monthlyBudget','startWhen','businessStage','leaseTerm'
      ]) && a.keys().hasOnly([
        'businessType','location','size','monthlyBudget','startWhen','businessStage','leaseTerm'
      ])
      && a.businessType in ['comercio','oficina','gastronomia','servicios','bodega','otro']
      && validGuideLocation(a.location)
      && a.size in ['menos-50','50-150','150-300','mas-300','flexible']
      && validPositiveOptional(a.monthlyBudget)
      && a.startWhen in ['ahora','1-3','flexible']
      && a.businessStage in ['establecido','emprendimiento','otro']
      && a.leaseTerm in ['menos-ano','1-3','mas-3','a-convenir'];
    }

    function validOfferAnswers(a) {
      return a.keys().hasAll([
        'spaceType','location','area','condition','titleStatus',
        'startWhen','services','monthlyRent'
      ]) && a.keys().hasOnly([
        'spaceType','location','area','condition','titleStatus',
        'startWhen','services','monthlyRent'
      ])
      && a.spaceType in ['local','oficina','bodega','edificio','otro']
      && validGuideLocation(a.location)
      && validPositiveOptional(a.area)
      && a.condition in ['listo','adecuaciones','ocupado']
      && a.titleStatus in ['si','tramite','no-se']
      && a.startWhen in ['ahora','1-3','flexible']
      && a.services in ['si','parcial','no']
      && validPositiveOptional(a.monthlyRent);
    }

    function validServiceGuideRequest() {
      let data = request.resource.data;
      let fields = [
        'firstName','lastName','phone','guideType','answers',
        'consent','status','createdAt'
      ];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && validGuideNameAndContact(data)
        && data.guideType in ['venta','buscar-renta','ofrecer-renta']
        && data.answers is map
        && (
          (data.guideType == 'venta' && validSaleAnswers(data.answers))
          || (data.guideType == 'buscar-renta' && validSeekAnswers(data.answers))
          || (data.guideType == 'ofrecer-renta' && validOfferAnswers(data.answers))
        )
        && data.consent == true
        && data.status == 'nuevo'
        && data.createdAt == request.time;
    }

    match /purchase_requests/{requestId} {
      allow create: if requestId.matches('^[A-Za-z0-9]{20}$')
        && validGuideRequest();
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['nuevo', 'contactado', 'atendido'];
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
