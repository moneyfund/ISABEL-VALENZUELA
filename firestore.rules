rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'norvingarcia220@gmail.com'
          || request.auth.token.email == 'valenzuela.ing120@gmail.com'
        );
    }

    match /site/{pageId} {
      allow get: if pageId == 'public';
      allow list: if false;
      allow create, update, delete: if pageId == 'public' && isAdmin();
    }

    match /properties/{propertyId} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
