rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && (
          request.auth.token.email == 'norvingarcia220@gmail.com'
          || request.auth.token.email == 'valenzuela.ing120@gmail.com'
        );
    }
    function validImageUpload() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /property-images/{propertyId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageUpload();
      allow delete: if isAdmin();
    }
    match /site-images/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageUpload();
      allow delete: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
